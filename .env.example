# Choisir explicitement un seul mode. Seules les chaînes exactes true et false sont admises.
# Toute valeur absente ou invalide affiche « N/A — mode de données non configuré »
# sans requête réseau ni chargement de fixture.

# Dashboard fictif riche, local uniquement.
VITE_USE_MOCKS=true

# Pour consulter exclusivement le manifeste public réel, remplacer la ligne ci-dessus par :
# VITE_USE_MOCKS=false
# L'URL est une origine HTTP(S) pure, sans /api, /api/v1, query, fragment ni identifiants.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=https://api.example.org
# Le client utilise alors GET {origin}/api/v1/incident/{fire_id}/manifest.

# Refonte événementielle additive. Vite exige le préfixe VITE_ ; la partie
# située après ce préfixe reprend exactement le nom du flag backend.
VITE_FV_EVENT_V2_ENABLED=false
VITE_FV_SUPABASE_AUTH_ENABLED=false
VITE_FV_OFFICIAL_CONNECTORS_ENABLED=false
VITE_FV_AGENT_EVENT_PIPELINE_ENABLED=false
VITE_FV_3D_PRIMARY_ENABLED=false
VITE_FV_V2_PUBLICATION_ENABLED=false

# Supabase sert uniquement à l'identité. Utiliser exclusivement la clé
# publiable `sb_publishable_*`. Ne jamais placer de clé secrète ou service role
# dans une variable VITE_, car elle serait intégrée au bundle navigateur.
# VITE_SUPABASE_URL=https://project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
